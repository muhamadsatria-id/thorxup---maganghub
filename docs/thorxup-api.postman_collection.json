{
  "info": {
    "_postman_id": "a8f3b0d1-7e5c-4c1e-9a2f-6f4c1b9d8e21",
    "name": "THORXup API v1",
    "description": "Koleksi endpoint publik THORXup. Atur variabel base_url dan ID data sesuai database lokal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "product_id",
      "value": "1"
    },
    {
      "key": "category_id",
      "value": "1"
    },
    {
      "key": "news_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('API is healthy', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Home aggregate",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/home"
      }
    },
    {
      "name": "Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/profile"
      }
    },
    {
      "name": "Carousels",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/carousels"
      }
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/categories"
          }
        },
        {
          "name": "Category detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/categories/{{category_id}}"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/products?per_page=6"
          }
        },
        {
          "name": "Search and filter products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/products?q=snare&category={{category_id}}&featured=true&sort=name&per_page=6"
          }
        },
        {
          "name": "Product detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/products/{{product_id}}"
          }
        }
      ]
    },
    {
      "name": "News",
      "item": [
        {
          "name": "List news",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/news?per_page=6"
          }
        },
        {
          "name": "Search news",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/news?q=snare"
          }
        },
        {
          "name": "News detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/news/{{news_id}}"
          }
        }
      ]
    },
    {
      "name": "Inquiries",
      "item": [
        {
          "name": "Create inquiry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SMA Negeri 1 Bandung\",\n  \"company\": \"SMA Negeri 1 Bandung\",\n  \"email\": \"humas@example.test\",\n  \"phone\": \"081234567890\",\n  \"product_id\": {{product_id}},\n  \"quantity\": 8,\n  \"subject\": \"Penawaran snare untuk tim drumband\",\n  \"message\": \"Kami ingin meminta penawaran untuk 8 unit snare drum sekolah.\"\n}"
            },
            "url": "{{base_url}}/inquiries"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('inquiry has new status', function () { pm.expect(pm.response.json().data.status).to.eql('new'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create inquiry validation error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"abc\",\n  \"subject\": \"\",\n  \"message\": \"pendek\"\n}"
            },
            "url": "{{base_url}}/inquiries"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 422', function () { pm.response.to.have.status(422); });",
                  "pm.test('has validation errors', function () { pm.expect(pm.response.json().errors).to.be.an('object'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
